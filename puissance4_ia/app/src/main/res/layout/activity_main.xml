            <ImageButton android:id="@+id/imageButton35" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton36" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />

            <ImageButton android:id="@+id/imageButton37" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton38" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton39" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton40" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton41" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton42" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton43" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />

            <ImageButton android:id="@+id/imageButton44" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton45" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton46" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton47" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton48" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton49" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
            <ImageButton android:id="@+id/imageButton50" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" app:srcCompat="@drawable/p24blanc" />
        </androidx.gridlayout.widget.GridLayout>

        <!-- Message de statut dynamique -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20sp"
            android:text="AU JOUEUR JAUNE DE JOUER"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Bouton de réinitialisation -->
        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20sp"
            android:onClick="init"
            android:text="Réinitialiser le jeu"
            android:textSize="20sp" />

    </LinearLayout>
</ScrollView>